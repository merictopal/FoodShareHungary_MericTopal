# FoodShare Hungary mobile configuration (copy to FoodShareMobile/.env and fill in).
# Placeholders only - never commit the real FoodShareMobile/.env.

# Backend base URL. 10.0.2.2 is the Android emulator's alias for the host machine's localhost.
API_URL=http://10.0.2.2:5000/api

# OAuth 2.0 *Web* client ID used by Google Sign-In (same value as GOOGLE_WEB_CLIENT_ID in backend/.env).
GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Google Maps SDK for Android key, read by android/app/build.gradle at build time.
# Left EMPTY on purpose: build.gradle treats an empty value as "not set" (build warning, map without tiles).
MAPS_API_KEY=
