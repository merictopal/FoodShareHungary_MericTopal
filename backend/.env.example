# FoodShare Hungary backend configuration: copy to backend/.env and fill in.
# Placeholders only - never commit the real backend/.env.
# Optional values are left EMPTY on purpose: the code treats an empty value as "not configured"
# (a placeholder text would be treated as a real credential).

# --- Required ---
# Signing key for access/refresh JWTs. The app refuses to start without it. Use a long random value.
JWT_SECRET_KEY=YOUR_LONG_RANDOM_JWT_SECRET
# PostgreSQL + PostGIS database used by the development config (the default config).
DEV_DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@127.0.0.1/foodshare_db

# --- Recommended ---
# Flask secret key (config.py falls back to a hard-coded value when this is empty).
SECRET_KEY=YOUR_FLASK_SECRET_KEY

# --- Optional: Google Sign-In (POST /api/auth/google answers 503 while empty) ---
# OAuth 2.0 Web client ID, e.g. 1234567890-abc.apps.googleusercontent.com.
# Must be the same value as GOOGLE_WEB_CLIENT_ID in FoodShareMobile/.env.
GOOGLE_WEB_CLIENT_ID=

# --- Optional: AWS S3 storage (while the two keys are empty, uploads are stored locally) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=

# --- Optional: password-reset e-mails, sent through smtp.gmail.com:587 (no e-mail is sent while empty) ---
# SMTP_EMAIL: the Gmail sender address; SMTP_APP_PASSWORD: a Gmail app password for that account.
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# --- Optional: server / CORS (code defaults shown) ---
# FLASK_CONFIG=development
# BACKEND_HOST=127.0.0.1
# BACKEND_PORT=5000
# CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Read only by the "production" config (FLASK_CONFIG=production):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME
